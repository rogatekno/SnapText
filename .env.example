# Application Configuration
APP_NAME=SnapText
APP_VERSION=1.0.0
APP_DESCRIPTION=FastAPI OCR Service with PaddleOCR
ENVIRONMENT=development
DEBUG=true

# Server Configuration
HOST=0.0.0.0
PORT=8000
WORKERS=1

# CORS Configuration
CORS_ORIGINS=["http://localhost:3000", "http://localhost:8000"]
CORS_ALLOW_CREDENTIALS=true
CORS_ALLOW_METHODS=["*"]
CORS_ALLOW_HEADERS=["*"]

# PaddleOCR Configuration
PADDLEOCR_LANG=en
PADDLEOCR_USE_ANGLE_CLS=true

# PaddlePaddle Configuration
# Disable OneDNN to avoid compatibility issues
INFERENCE_ENFORCE_USE_ONEDNN=0
FLAGS_use_mkldnn=false

# Upload Configuration
MAX_UPLOAD_SIZE_MB=10
ALLOWED_EXTENSIONS=["jpg", "jpeg", "png", "bmp", "tiff", "webp"]

# Logging Configuration
LOG_LEVEL=INFO
LOG_FORMAT=text  # or 'json' for structured logging
LOG_FILE_PATH=logs/app.log
LOG_ROTATION=500 MB
LOG_RETENTION=10 days

# API Configuration
API_V1_PREFIX=/api/v1
HEALTH_CHECK_INTERVAL=30

# LLM Configuration
# Provider options: 'local' (llama-cpp), 'gemini', 'openai'
LLM_ENABLED=true
LLM_PROVIDER=gemini

# Local LLM (used when LLM_PROVIDER=local)
LLM_MODEL_PATH=models/qwen2.5-0.5b-instruct-q5_k_m.gguf
LLM_N_CTX=2048

# Google Gemini (used when LLM_PROVIDER=gemini)
# Models: gemini-2.0-flash-lite (~$0.075/1M in), gemini-1.5-flash (~$0.075/1M in)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash-lite

# OpenAI (used when LLM_PROVIDER=openai)
# Models: gpt-4o-mini (~$0.15/1M in), gpt-4o (~$2.5/1M in)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Performance Configuration
REQUEST_TIMEOUT_SECONDS=60
ASYNC_PROCESSING_ENABLED=true
